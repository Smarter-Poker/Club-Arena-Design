{
    "name": "club-engine",
    "version": "1.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "migrate": "node scripts/migrate.js",
        "migrate:all": "node scripts/migrate.js --all",
        "types:generate": "npx supabase gen types typescript --project-id kuklfnapbkmacvwxktbh --schema public > src/types/supabase.ts"
    },
    "dependencies": {
        "@react-three/drei": "^10.0.0",
        "@react-three/fiber": "^9.0.0",
        "@sentry/react": "^10.38.0",
        "@sentry/vite-plugin": "^4.8.0",
        "@supabase/supabase-js": "^2.49.0",
        "@types/md5": "^2.3.6",
        "framer-motion": "^11.18.0",
        "md5": "^2.3.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-router-dom": "^7.1.1",
        "recharts": "^3.7.0",
        "three": "^0.172.0",
        "zustand": "^5.0.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@playwright/test": "^1.58.0",
        "@types/node": "^22.10.7",
        "@types/react": "^19.0.7",
        "@types/react-dom": "^19.0.3",
        "@types/three": "^0.172.0",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitest/ui": "^4.0.18",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.18.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "eslint-plugin-react-refresh": "^0.4.18",
        "globals": "^15.14.0",
        "postcss": "^8.5.1",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0",
        "vite": "^6.0.7",
        "vitest": "^4.0.18"
    }
}